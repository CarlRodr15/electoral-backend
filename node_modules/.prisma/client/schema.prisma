// --- CABECERA DE CONEXIÓN (¡No borrar!) ---
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- MODELOS DE DATOS ---

model Usuario {
  id         Int     @id @default(autoincrement())
  nombre     String
  cedula     String  @unique
  telefono   String?
  rol        String // Puede ser: 'ADMIN', 'CONCEJAL', 'LIDER'
  contrasena String

  // --- JERARQUÍA: RELACIÓN CONCEJAL -> LÍDER ---
  // Un líder pertenece a un concejal
  concejalId Int?
  concejal   Usuario? @relation("EquipoConcejal", fields: [concejalId], references: [id])

  // Un concejal tiene un equipo de líderes
  equipoLideres Usuario[] @relation("EquipoConcejal")

  // Un líder tiene muchos simpatizantes
  simpatizantes Simpatizante[]
}

model Simpatizante {
  id             Int     @id @default(autoincrement())
  nombreCompleto String
  cedula         String  @unique
  telefono       String?

  // --- NUEVA SEGMENTACIÓN GEOGRÁFICA ---
  zona         String // 'URBANA' o 'RURAL'
  barrioVereda String // Nombre específico del barrio o la vereda
  direccion    String?
  latitud      Float?
  longitud     Float?

  // Conservamos la intención de voto general
  apoyaAlcaldia Boolean @default(false)
  apoyaConcejo  Boolean @default(false)

  // Relación con el líder que lo registró
  liderId Int
  lider   Usuario @relation(fields: [liderId], references: [id])
}
