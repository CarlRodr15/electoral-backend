// --- CABECERA DE CONEXIÓN (¡No borrar!) ---
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- MODELOS DE DATOS ---

model Usuario {
  id             Int       @id @default(autoincrement())
  nombre         String
  cedula         String    @unique
  telefono       String?
  rol            String    // Puede ser: 'ADMIN', 'CONCEJAL', 'LIDER'
  contrasena     String

  // --- JERARQUÍA: RELACIÓN CONCEJAL -> LÍDER ---
  // Un líder pertenece a un concejal
  concejalId     Int?
  concejal       Usuario?  @relation("EquipoConcejal", fields: [concejalId], references: [id])
  
  // Un concejal tiene un equipo de líderes
  equipoLideres  Usuario[] @relation("EquipoConcejal")

  // Un líder tiene muchos simpatizantes
  simpatizantes  Simpatizante[]
}

model Simpatizante {
  id              Int       @id @default(autoincrement())
  nombreCompleto  String
  cedula          String    @unique
  telefono        String?
  zona            String
  barrioVereda    String
  direccion       String
  latitud         Float?
  longitud        Float?
  apoyaAlcaldia   Boolean   @default(false)
  apoyaConcejo    Boolean   @default(false)
  liderId         Int
  lider           Usuario   @relation(fields: [liderId], references: [id])
  mesa            String?
  observaciones   String?
}

model Alerta {
  id        Int      @id @default(autoincrement())
  cedula    String
  nombre    String
  motivo    String
  fecha     DateTime @default(now())
}